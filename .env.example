# Copy to .env and fill in. .env is gitignored.

# From Spotify dashboard -> your app -> Settings. Client ID only, no secret needed (PKCE).
SPOTIFY_CLIENT_ID=

# Must exactly match a Redirect URI registered in the Spotify dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback/spotify

# Must be loopback (matches the Google OAuth "Desktop app" client type) and
# must be the exact host string the kiosk browser uses to load the app -
# don't mix 127.0.0.1 and localhost between this and your browser's address bar.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Any random string - used to sign the Flask session cookie (holds the OAuth
# state param between /auth/google/start and /auth/google/callback).
FLASK_SECRET_KEY=
